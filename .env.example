# Copy to .env for local dev. In CI (Codemagic), set these as a "supabase" environment group.
# The anon key is a publishable client key (RLS-protected) — still kept out of git.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Error-report source maps (Better Stack → Errors → app → Advanced settings). Secret token: never commit.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_URL=https://xxx-sourcemaps.betterstackdata.com
# SENTRY_AUTH_TOKEN=
